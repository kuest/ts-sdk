{
  "name": "@kuest/bindings",
  "version": "0.14.0",
  "description": "Internal API bindings for the unified SDK",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuest/ts-sdk.git",
    "directory": "packages/bindings"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./clob": {
      "types": "./dist/clob/index.d.ts",
      "default": "./dist/clob/index.js"
    },
    "./combos": {
      "types": "./dist/combos/index.d.ts",
      "default": "./dist/combos/index.js"
    },
    "./gamma": {
      "types": "./dist/gamma/index.d.ts",
      "default": "./dist/gamma/index.js"
    },
    "./data": {
      "types": "./dist/data/index.d.ts",
      "default": "./dist/data/index.js"
    },
    "./relayer": {
      "types": "./dist/relayer/index.d.ts",
      "default": "./dist/relayer/index.js"
    },
    "./perps": {
      "types": "./dist/perps/index.d.ts",
      "default": "./dist/perps/index.js"
    },
    "./subscriptions": {
      "types": "./dist/subscriptions/index.d.ts",
      "default": "./dist/subscriptions/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "clob": [
        "./dist/clob/index.d.ts"
      ],
      "combos": [
        "./dist/combos/index.d.ts"
      ],
      "data": [
        "./dist/data/index.d.ts"
      ],
      "gamma": [
        "./dist/gamma/index.d.ts"
      ],
      "perps": [
        "./dist/perps/index.d.ts"
      ],
      "relayer": [
        "./dist/relayer/index.d.ts"
      ],
      "subscriptions": [
        "./dist/subscriptions/index.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "dependencies": {
    "@kuest/types": "workspace:*",
    "zod": "^4.6.7"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^6.0.2"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
